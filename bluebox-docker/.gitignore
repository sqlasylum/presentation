# Environment
.env
*.local

# Scratch files and notes
scratch.*
*.note
*.tmp
*.bak
*.log

# Data files (too large for git)
# Keep compressed init files, but not uncompressed
!init/*.sql
!init/*.sql.gz
init/*.csv
!init/*.csv.gz

# Backup directories from fix-init-scripts.sh
init_backup_*

# Cached images (posters are downloaded at runtime)
bluebox-app/public/posters/*.jpg
bluebox-app/public/posters/*.png

# Temp files

# Session logs (chat history, may contain local paths/usernames)
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo
