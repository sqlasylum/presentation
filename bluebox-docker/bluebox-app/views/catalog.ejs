<%- include('partials/header', { title: 'Browse', page: 'catalog' }) %>

<div class="row align-items-center mb-4">
  <div class="col">
    <h4 class="text-white mb-0">Browse Films</h4>
    <small class="text-muted"><%= total.toLocaleString() %> titles available</small>
  </div>
</div>

<!-- Search + genre filter -->
<form method="GET" action="/" class="row g-2 mb-4">
  <div class="col-12 col-md-5">
    <div class="input-group">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input type="text" class="form-control" name="q" value="<%= q %>" placeholder="Search titles and descriptions…">
    </div>
  </div>
  <div class="col-8 col-md-3">
    <select name="genre" class="form-select">
      <option value="">All Genres</option>
      <% genres.forEach(g => { %>
      <option value="<%= g.name %>" <%= genre === g.name ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-4 col-md-2">
    <button type="submit" class="btn btn-bb w-100">Search</button>
  </div>
  <% if (q || genre) { %>
  <div class="col-12 col-md-2">
    <a href="/" class="btn btn-outline-secondary w-100">Clear</a>
  </div>
  <% } %>
</form>

<!-- Film grid -->
<% if (films.length === 0) { %>
<div class="text-center py-5">
  <i class="bi bi-film" style="font-size:3rem;color:#444"></i>
  <p class="mt-3 text-muted">No films matched. <a href="/" class="text-decoration-none" style="color:var(--bb-blue)">Clear search</a></p>
</div>
<% } else { %>
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-6 g-3">
  <% films.forEach(film => { %>
  <div class="col">
    <a href="/film/<%= film.film_id %>" class="text-decoration-none">
      <div class="card hoverable h-100 p-2">
        <!-- Poster Image Container -->
        <div class="film-poster-container mb-2" style="background:#222;border-radius:4px;overflow:hidden;aspect-ratio:2/3;display:flex;align-items:center;justify-content:center">
          <img class="film-poster" 
               src="/posters/placeholder.svg" 
               data-film-id="<%= film.film_id %>" 
               data-film-title="<%= film.title %>"
               style="width:100%;height:100%;object-fit:cover;background:#333" 
               alt="<%= film.title %>">
        </div>
        
        <div class="d-flex justify-content-between align-items-start mb-1">
          <% if (film.rating) { %><span class="badge bg-secondary" style="font-size:.65rem"><%= film.rating %></span><% } else { %><span></span><% } %>
          <% if (parseInt(film.available_copies) > 0) { %>
          <span class="badge badge-avail"><i class="bi bi-check-circle-fill"></i></span>
          <% } else { %>
          <span class="badge badge-out"><i class="bi bi-dash-circle-fill"></i></span>
          <% } %>
        </div>
        <p class="text-white mb-1 fw-semibold" style="font-size:.82rem;line-height:1.25;min-height:2.5rem"><%= film.title %></p>
        <div class="mt-auto">
          <% if (film.primary_genre) { %><small class="text-muted d-block" style="font-size:.7rem"><%= film.primary_genre %></small><% } %>
          <% if (film.release_date) { %><small class="text-muted" style="font-size:.7rem"><%= new Date(film.release_date).getFullYear() %></small><% } %>
        </div>
        <% if (cartFilmIds.includes(film.film_id)) { %>
        <div class="mt-2">
          <span class="badge w-100 py-1" style="background:#1a3a1a;color:#b7e4c7;font-size:.7rem"><i class="bi bi-bag-check me-1"></i>In Cart</span>
        </div>
        <% } %>
      </div>
    </a>
  </div>
  <% }) %>
</div>

<!-- Script to fetch and cache poster images -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
  const posterImages = document.querySelectorAll('.film-poster');
  
  for (const img of posterImages) {
    const filmId = img.dataset.filmId;
    const filmTitle = img.dataset.filmTitle;
    
    try {
      // Fetch poster URL from server (which will cache it)
      const response = await fetch(`/api/poster/${filmId}/${encodeURIComponent(filmTitle)}`);
      const data = await response.json();
      
      if (data.posterUrl) {
        img.src = data.posterUrl;
        img.onerror = () => {
          img.src = '/posters/placeholder.svg';
        };
      }
    } catch (err) {
      console.error(`Failed to load poster for ${filmTitle}:`, err);
      img.src = '/posters/placeholder.svg';
    }
  }
});
</script>
<% } %>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<nav class="mt-4">
  <ul class="pagination justify-content-center flex-wrap gap-1">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="/?q=<%= encodeURIComponent(q) %>&genre=<%= encodeURIComponent(genre) %>&page=<%= page-1 %>">‹</a>
    </li>
    <% const start = Math.max(1, page-3); const end = Math.min(totalPages, page+3); %>
    <% for (let i = start; i <= end; i++) { %>
    <li class="page-item <%= i === page ? 'active' : '' %>">
      <a class="page-link" href="/?q=<%= encodeURIComponent(q) %>&genre=<%= encodeURIComponent(genre) %>&page=<%= i %>"><%= i %></a>
    </li>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="/?q=<%= encodeURIComponent(q) %>&genre=<%= encodeURIComponent(genre) %>&page=<%= page+1 %>">›</a>
    </li>
  </ul>
</nav>
<% } %>

<%- include('partials/footer') %>
